# Copie para apps/api/.env e ajuste. NUNCA versione arquivos .env com segredos reais.

# Ambiente: development | test | production
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL (docker compose expõe na porta 5433)
DATABASE_URL=postgresql://reformar:reformar_dev@localhost:5433/reformar
DATABASE_URL_TEST=postgresql://reformar:reformar_dev@localhost:5433/reformar_test

# Origem do front-end (usada na verificação anti-CSRF). Vários valores separados por vírgula.
APP_ORIGIN=http://localhost:5180
# URL pública usada para montar links de compartilhamento de orçamento
PUBLIC_APP_URL=http://localhost:5180

# Sessão
SESSION_TTL_DAYS=30
# true em produção (HTTPS). Em desenvolvimento local pode ficar false.
COOKIE_SECURE=false
# Defina true se a API estiver atrás de proxy reverso confiável (para IP real e HTTPS)
TRUST_PROXY=false

# Em produção, a API pode servir o build do front-end (apps/web/dist)
SERVE_WEB_DIR=

# E-mail (recuperação de senha). "console" só é aceito em development.
# Valores: none | console. (SMTP ainda não implementado — ver docs/PLANO_IMPLEMENTACAO.md)
MAILER=console

# Pasta dos arquivos enviados (fotos, comprovantes) quando o armazenamento é em disco local
STORAGE_DIR=./storage

# ---------- Assistente (Fase 3) ----------
# none = desligado (os formulários continuam funcionando) | anthropic = Claude via API oficial
AI_PROVIDER=none
# Chave lida automaticamente pelo SDK. Somente no servidor; nunca no front-end.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Esforço do modelo (custo x qualidade). Extração simples: low.
AI_EFFORT=low
# Limite mensal de pedidos por empresa sem plano (com plano, vale a franquia do plano)
AI_MONTHLY_REQUEST_LIMIT=100

# ---------- Assinatura da plataforma (Asaas e PayPal) ----------
# O jeito recomendado é configurar os meios de pagamento no painel da plataforma (/plataforma → Meios de pagamento).
# As credenciais salvas lá ficam cifradas com esta chave (32 bytes em base64). Gere com: openssl rand -base64 32
# Sem ela o painel não salva credenciais. Trocar a chave invalida as credenciais já salvas (cadastre de novo).
SECRETS_KEY=
# Alternativa antiga (só Asaas): variáveis abaixo. O que estiver salvo no painel tem prioridade.
# Sem nenhum meio de pagamento ativo a cobrança fica desligada e ninguém é bloqueado.
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com · Produção: https://api.asaas.com (docs.asaas.com, conferido em 13/11/2026). Em produção é obrigatório informar.
ASAAS_BASE_URL=
# Token configurado no webhook do Asaas (32+ caracteres, sem espaços, diferente da chave de API)
ASAAS_WEBHOOK_TOKEN=
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=7
