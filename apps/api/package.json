{
  "name": "@reformar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed:demo": "tsx --env-file-if-exists=.env src/seed-demo.ts",
    "postinstall": "prisma generate",
    "platform:admin": "tsx --env-file-if-exists=.env src/make-platform-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^10.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@reformar/shared": "*",
    "dotenv": "^17.0.0",
    "fastify": "^5.6.0",
    "pdfkit": "^0.17.0",
    "pg": "^8.23.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.0",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "vitest": "^4.0.0"
  }
}
